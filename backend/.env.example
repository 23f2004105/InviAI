# Copy to backend/.env and fill in. Never commit the real .env.

# Local Postgres (or a Neon connection string with ?sslmode=require)
DATABASE_URL=postgresql://inviai_user:change-me@localhost:5432/inviai_db

# development | production. Outside development JWT_SECRET_KEY is required.
ENVIRONMENT=development

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Optional: Google Gemini key for the AI advisor (https://aistudio.google.com)
GEMINI_API_KEY=

# Optional tuning
# AUTH_RATE_LIMIT=5/minute
# RUN_MIGRATIONS_ON_STARTUP=true
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
